---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SecretNotesDemo from "../../components/SecretNotesDemo.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, tags, githubUrl, liveUrl, demoUrl, image } = project.data;
const isSecretNotes = project.id === "secret-notes";
---

<BaseLayout title={title} description={description}>
  <div class:list={["container", isSecretNotes && "demo-project"]}>
    {isSecretNotes ? (
      <>
        <SecretNotesDemo />
        <article class="demo-writeup">
          <p class="eyebrow">Software demo</p>
          <h1>{title}</h1>
          <p class="lede">{description}</p>
          <div class="meta-row" style="margin-bottom: 1.25rem;">
            {tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
          <div class="actions">
            {githubUrl && (
              <a class="button button-ghost" href={githubUrl} rel="noreferrer">GitHub</a>
            )}
            <a class="button button-ghost" href="/#software">Projects</a>
            <a class="button button-ghost" href="/status">Status</a>
          </div>
          <div class="prose section">
            <Content />
          </div>
        </article>
      </>
    ) : (
      <>
        <p class="eyebrow">Software</p>
        <div class="project-hero">
          <div>
            <h1>{title}</h1>
            <p class="lede">{description}</p>
            <div class="meta-row" style="margin-bottom: 1.25rem;">
              {tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
            <div class="actions">
              {demoUrl && (
                <a class="button button-ghost" href={demoUrl}>Open demo</a>
              )}
              {githubUrl && (
                <a class="button button-ghost" href={githubUrl} rel="noreferrer">GitHub</a>
              )}
              {liveUrl && (
                <a class="button button-ghost" href={liveUrl} rel="noreferrer">Live site</a>
              )}
              <a class="button button-ghost" href="/projects">All work</a>
            </div>
          </div>
          {image && (
            <div class="project-cover">
              <img src={image.src} alt={image.alt} />
            </div>
          )}
        </div>
        <div class="prose section">
          <Content />
        </div>
      </>
    )}
  </div>
</BaseLayout>
