---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, kind, tags, itchUrl, githubUrl, liveUrl, demoUrl, image } =
  project.data;
---

<BaseLayout title={title} description={description}>
  <div class="container">
    <p class="eyebrow">{kind === "game" ? "Game" : "Software"}</p>
    <div class="project-hero">
      <div>
        <h1>{title}</h1>
        <p class="lede">{description}</p>
        <div class="meta-row" style="margin-bottom: 1.25rem;">
          {tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
        <div class="actions">
          {itchUrl && (
            <a class="button button-primary" href={itchUrl} rel="noreferrer">Play on itch.io</a>
          )}
          {demoUrl && (
            <a class="button button-ghost" href={demoUrl}>Play demo</a>
          )}
          {githubUrl && (
            <a class="button button-ghost" href={githubUrl} rel="noreferrer">GitHub</a>
          )}
          {liveUrl && (
            <a class="button button-ghost" href={liveUrl} rel="noreferrer">Live site</a>
          )}
          <a class="button button-ghost" href="/projects">All work</a>
        </div>
      </div>
      <div class="project-cover">
        {image && <img src={image.src} alt={image.alt} />}
      </div>
    </div>

    <div class="prose section">
      <Content />
    </div>
  </div>
</BaseLayout>
