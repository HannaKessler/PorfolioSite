---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const games = projects.filter((project) => project.data.kind === "game");
const software = projects.filter((project) => project.data.kind === "software");
---

<BaseLayout title="Work" description="Selected games and software projects.">
  <div class="container">
    <p class="eyebrow">Selected work</p>
    <h1>Projects</h1>
    <p class="lede">Games link out to itch.io. Software points to source, live demos, or write-ups.</p>

    <section class="section" aria-labelledby="games-heading">
      <div class="section-head">
        <h2 id="games-heading">Games</h2>
      </div>
      {games.length > 0 ? (
        <div class="grid">
          {games.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      ) : (
        <p class="empty-note">No games yet. Add a Markdown file with <code>kind: game</code>.</p>
      )}
    </section>

    <section class="section" aria-labelledby="software-heading">
      <div class="section-head">
        <h2 id="software-heading">Software</h2>
      </div>
      {software.length > 0 ? (
        <div class="grid">
          {software.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      ) : (
        <p class="empty-note">No software projects yet. Add a Markdown file with <code>kind: software</code>.</p>
      )}
    </section>
  </div>
</BaseLayout>
