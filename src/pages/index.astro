---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { site } from "../site";

const projects = (await getCollection("projects"))
  .filter((project) => project.data.listed)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const demos = projects.filter((project) => project.data.kind === "demo");
const tools = projects.filter((project) => project.data.kind === "project");
---

<BaseLayout>
  <section class="hero">
    <img
      class="hero-banner"
      src="/images/_night-crop-preview.jpg"
      alt="The Austin, Texas skyline lit up at night"
      width="1200"
      height="450"
    />
    <div class="hero-inner">
      {site.role ? (
        <>
          <p class="hero-kicker">{site.name}</p>
          <h1>{site.role}</h1>
        </>
      ) : (
        <h1>{site.name}</h1>
      )}
      <nav class="hero-tabs" aria-label="Sections">
        <div class="nav-menu">
          <button
            type="button"
            class="nav-trigger"
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="hero-demo-menu"
          >
            Demos
          </button>
          <ul class="nav-dropdown" id="hero-demo-menu">
            {demos.map((project) => (
              <li>
                <a href={`/projects/${project.id}`}>{project.data.title}</a>
              </li>
            ))}
          </ul>
        </div>
        <a href={site.links.linkedin} rel="noreferrer">LinkedIn</a>
        {/* Hidden until the Professional Journey page is filled out. <a href="/professional-journey">Professional Journey</a> */}
        <a href={site.links.itch} rel="noreferrer">Game Jams</a>
        <a href={site.links.github} rel="noreferrer">Repo</a>
      </nav>
    </div>
  </section>

  <div class="container">
    <section class="profile" id="about">
      <div class="profile-copy">
        <h2 class="profile-role">About</h2>
        {site.intro.map((paragraph) => (
          <p class="profile-bio">{paragraph}</p>
        ))}
        {site.experience.length > 0 && (
          <>
            <p class="profile-bio">I have experience in:</p>
            <ul class="experience">
              {site.experience.map((item) => (
                <li>
                  <span>{item.title}:</span> {item.detail}
                </li>
              ))}
            </ul>
          </>
        )}
        {/* Hidden until the Professional Journey page is filled out. <a class="button button-ghost button-small" href="/professional-journey">Professional Journey</a> */}
      </div>
      <div class="profile-media">
        <img class="profile-photo" src={site.photo} alt={`Portrait of ${site.name}`} />
        {site.resumeUrl && (
          <a class="button button-primary" href={site.resumeUrl} rel="noreferrer">Resume</a>
        )}
      </div>
    </section>

    <section class="listing-section" id="software" aria-labelledby="software-heading">
      <h2 id="software-heading">Demos</h2>
      {demos.length > 0 ? (
        <div class="grid">
          {demos.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      ) : (
        <p class="empty-note">Add a Markdown file in <code>src/content/projects</code>.</p>
      )}
    </section>

    {tools.length > 0 && (
      <section class="listing-section" id="projects" aria-labelledby="projects-heading">
        <h2 id="projects-heading">Projects</h2>
        <div class="grid">
          {tools.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </section>
    )}
  </div>
  <p slot="footer">
    Austin skyline at night by <a href="https://www.flickr.com/people/47121680@N00" rel="noreferrer">Jonathan Cutrer</a>, cropped from <a href="https://www.flickr.com/photos/joncutrer/10555159946/" rel="noreferrer">Austin Texas Downtown Skyline at Night</a>, <a href="https://creativecommons.org/licenses/by/2.0" rel="noreferrer">CC BY 2.0</a>, via <a href="https://commons.wikimedia.org/wiki/File:Austin_Texas_Downtown_Skyline_at_Night_(10555159946).jpg" rel="noreferrer">Wikimedia Commons</a>.
  </p>
</BaseLayout>
