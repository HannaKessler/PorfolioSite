---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { site } from "../site";

const projects = (await getCollection("projects"))
  .filter((project) => project.data.listed)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout>
  <section class="hero">
    <img
      class="hero-banner"
      src="/images/austin-skyline.jpg"
      alt="Aerial view of the Austin, Texas skyline along the Colorado River"
      width="2400"
      height="900"
    />
    <div class="hero-inner">
      {site.role ? (
        <>
          <p class="hero-kicker">{site.name}</p>
          <h1>{site.role}</h1>
        </>
      ) : (
        <h1>{site.name}</h1>
      )}
      <nav class="hero-tabs" aria-label="Sections">
        <div class="nav-menu">
          <button
            type="button"
            class="nav-trigger"
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="hero-demo-menu"
          >
            Demos
          </button>
          <ul class="nav-dropdown" id="hero-demo-menu">
            {projects.map((project) => (
              <li>
                <a href={`/projects/${project.id}`}>{project.data.title}</a>
              </li>
            ))}
          </ul>
        </div>
        <a href={site.links.linkedin} rel="noreferrer">LinkedIn</a>
        <a href="/professional-journey">Professional Journey</a>
        <a href={site.links.github} rel="noreferrer">Repo</a>
      </nav>
    </div>
  </section>

  <div class="container">
    <section class="profile" id="about">
      <div class="profile-copy">
        <p class="profile-name">About</p>
        <p class="profile-role">{site.name}</p>
        {site.intro.map((paragraph) => (
          <p class="profile-bio">{paragraph}</p>
        ))}
        {site.experience.length > 0 && (
          <>
            <p class="profile-bio">I have experience in:</p>
            <ul class="experience">
              {site.experience.map((item) => (
                <li>
                  <span>{item.title}:</span> {item.detail}
                </li>
              ))}
            </ul>
          </>
        )}
        <a class="button button-ghost button-small" href="/professional-journey">Professional Journey</a>
      </div>
      <div class="profile-media">
        <img class="profile-photo" src={site.photo} alt={`Portrait of ${site.name}`} />
        {site.resumeUrl && (
          <a class="button button-primary" href={site.resumeUrl} rel="noreferrer">Resume</a>
        )}
      </div>
    </section>

    <section class="listing-section" id="software" aria-labelledby="software-heading">
      <h2 id="software-heading">Demos</h2>
      {projects.length > 0 ? (
        <div class="grid">
          {projects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      ) : (
        <p class="empty-note">Add a Markdown file in <code>src/content/projects</code>.</p>
      )}
    </section>
  </div>
  <p slot="footer">
    Austin skyline by <a href="https://commons.wikimedia.org/wiki/User:Quintin_Soloviev" rel="noreferrer">Quintin Soloviev</a>, cropped from <a href="https://commons.wikimedia.org/wiki/File:Skyline_of_Austin,_Texas_(cropped).jpg" rel="noreferrer">Skyline of Austin, Texas</a>, <a href="https://creativecommons.org/licenses/by/4.0" rel="noreferrer">CC BY 4.0</a>, via <a href="https://commons.wikimedia.org/wiki/File:Skyline_of_Austin,_Texas_(cropped).jpg" rel="noreferrer">Wikimedia Commons</a>.
  </p>
</BaseLayout>
