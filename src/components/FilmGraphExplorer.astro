---
import "../styles/demo-layout.css";
import "../styles/film-graph.css";
import Explorer from "./film-graph/Explorer.tsx";
---

<section class="fg" id="film-graph" aria-label="Film Graph explorer">
  <Explorer client:only="react">
    <div slot="fallback" class="fg-banner" role="status">
      <div class="fg-spinner" aria-hidden="true"></div>
      <div>
        <strong>Loading the explorer…</strong>
        <p>Everything below runs in your browser, so the first visit downloads a small Postgres build.</p>
      </div>
    </div>
  </Explorer>
  <noscript>
    <p class="fg-noscript">
      This demo runs a database and an API inside your browser, so it needs JavaScript. The write-up below explains how
      it works.
    </p>
  </noscript>
</section>
