---
import "../styles/demo-layout.css";
---

<section class="fg" id="film-graph" aria-label="Film Graph explorer">
  <p id="fg-status" role="status">Starting the in-browser backend…</p>
  <pre id="fg-out"></pre>
</section>

<script>
  import { connect } from "../filmgraph/client/connection";
  import { GRAPHQL_URL, REST_BASE } from "../filmgraph/config";

  const status = document.getElementById("fg-status")!;
  const out = document.getElementById("fg-out")!;
  const connection = await connect((s) => {
    status.textContent = `${s.phase}: ${s.detail ?? ""} (${Math.round(s.elapsedMs)} ms)`;
    (window as any).__fgStatus = s;
  });
  const gql = await connection.fetch(GRAPHQL_URL, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ query: '{ film(id: "47703") { title year directors { name } } }' }),
  });
  const rest = await connection.fetch(`${REST_BASE}/films/47703`);
  const etag = rest.headers.get("etag");
  const again = await connection.fetch(`${REST_BASE}/films/47703`, { headers: { "If-None-Match": etag ?? "" } });
  const result = {
    mode: connection.mode,
    fallbackReason: connection.fallbackReason,
    graphql: { status: gql.status, queries: gql.headers.get("x-db-queries"), body: await gql.json() },
    rest: { status: rest.status, etag, title: (await rest.json()).title },
    revalidate: again.status,
  };
  (window as any).__fgSmoke = result;
  out.textContent = JSON.stringify(result, null, 2);
</script>
