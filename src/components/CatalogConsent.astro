<div id="os-consent" class="os-consent" hidden>
  <div class="os-consent-panel" role="dialog" aria-modal="true" aria-labelledby="os-consent-title">
    <h2 id="os-consent-title">Cookie consent</h2>
    <p id="os-consent-summary" hidden></p>
    <p>If you accept, this browser stores up to 8 recent searches for 30 days. Your choice is stored here too, so this notice is not shown again. Searches are not sent to a server. Rejecting, or changing this later, deletes the searches.</p>
    <div class="os-consent-actions">
      <button type="button" data-consent="denied">Reject</button>
      <button type="button" data-consent="granted">Accept</button>
    </div>
  </div>
</div>
