---
import { getCollection, render } from "astro:content";

interface Props {
  projectId: string;
}

const { projectId } = Astro.props;

const entries = (await getCollection("devlog"))
  .filter((entry) => entry.data.project === projectId)
  .sort((a, b) => {
    const byDate = a.data.date.valueOf() - b.data.date.valueOf();
    if (byDate !== 0) return byDate;
    return a.id.localeCompare(b.id);
  });

const rendered = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  })),
);

function formatDate(date: Date) {
  return new Intl.DateTimeFormat("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  }).format(date);
}
---

<section class="devlog" aria-labelledby="devlog-heading">
  <h2 id="devlog-heading">Dev Log</h2>
  <ol class="devlog-list">
    {
      rendered.map(({ entry, Content }) => (
        <li>
          <article class="devlog-entry" id={entry.id}>
            <header class="devlog-heading">
              <h3>
                <a href={`#${entry.id}`}>{entry.data.title}</a>
              </h3>
              <time class="devlog-date" datetime={entry.data.date.toISOString().slice(0, 10)}>
                {formatDate(entry.data.date)}
              </time>
            </header>
            <div class="prose">
              <Content />
            </div>
          </article>
        </li>
      ))
    }
    </ol>
</section>

<script>
  function setupGifPlayer(player: HTMLElement) {
    if (player.dataset.ready === "true") return;
    player.dataset.ready = "true";

    const image = player.querySelector("img");
    const button = player.querySelector("button");
    if (!(image instanceof HTMLImageElement) || !(button instanceof HTMLButtonElement)) return;

    const source = image.getAttribute("src") ?? "";
    let canvas: HTMLCanvasElement | null = null;
    let playing = true;

    function setPaused(paused: boolean) {
      playing = !paused;
      button.setAttribute("aria-label", paused ? "Play" : "Pause");
      button.setAttribute("aria-pressed", String(paused));
    }

    function freeze() {
      const width = image.naturalWidth;
      const height = image.naturalHeight;
      if (!width || !height) return;
      if (!canvas) {
        canvas = document.createElement("canvas");
        canvas.className = "gif-player-still";
        image.insertAdjacentElement("afterend", canvas);
      }
      canvas.width = width;
      canvas.height = height;
      canvas.getContext("2d")?.drawImage(image, 0, 0, width, height);
      image.hidden = true;
      canvas.hidden = false;
      setPaused(true);
    }

    function play() {
      image.hidden = false;
      if (canvas) canvas.hidden = true;
      image.src = "";
      image.src = source;
      setPaused(false);
    }

    button.addEventListener("click", () => {
      if (playing) freeze();
      else play();
    });
  }

  document.querySelectorAll<HTMLElement>(".gif-player").forEach(setupGifPlayer);
</script>
