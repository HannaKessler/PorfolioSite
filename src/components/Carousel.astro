---
import type { CollectionEntry } from "astro:content";
import ProjectCard from "./ProjectCard.astro";

interface Props {
  id: string;
  title: string;
  projects: CollectionEntry<"projects">[];
  emptyText: string;
}

const { id, title, projects, emptyText } = Astro.props;
const headingId = `${id}-heading`;
---

<section class="carousel-section" id={id} aria-labelledby={headingId} data-carousel>
  <div class="carousel-head">
    <h2 id={headingId}>{title}</h2>
    {projects.length > 1 && (
      <div class="carousel-controls">
        <button type="button" data-prev aria-label={`Previous ${title.toLowerCase()}`}>
          ‹
        </button>
        <button type="button" data-next aria-label={`Next ${title.toLowerCase()}`}>
          ›
        </button>
      </div>
    )}
  </div>

  {projects.length > 0 ? (
    <div class="carousel-track" data-scroller tabindex="0">
      {projects.map((project) => (
        <div class="carousel-slide">
          <ProjectCard project={project} />
        </div>
      ))}
    </div>
  ) : (
    <p class="empty-note">{emptyText}</p>
  )}
</section>

<style>
  .carousel-section {
    scroll-margin-top: 5rem;
    margin-top: 3.25rem;
  }

  .carousel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.1rem;
  }

  .carousel-head h2 {
    margin: 0;
    color: var(--name);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: clamp(1.35rem, 3vw, 1.85rem);
  }

  .carousel-controls {
    display: flex;
    gap: 0.45rem;
  }

  .carousel-controls button {
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--line);
    background: var(--bg-elevated);
    color: var(--text);
    font-size: 1.5rem;
    line-height: 1;
    border-radius: 999px;
    cursor: pointer;
  }

  .carousel-controls button:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .carousel-track {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding: 0.15rem 0.15rem 0.85rem;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
  }

  .carousel-track:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .carousel-slide {
    flex: 0 0 min(20.5rem, 82vw);
    scroll-snap-align: start;
  }

  .carousel-slide :global(.card) {
    height: 100%;
  }
</style>

<script>
  function cardStep(scroller: HTMLElement) {
    const slide = scroller.querySelector(".carousel-slide");
    const styles = getComputedStyle(scroller);
    const gap = Number.parseFloat(styles.columnGap || styles.gap) || 16;
    return (slide instanceof HTMLElement ? slide.offsetWidth : 280) + gap;
  }

  function setupCarousel(root: Element) {
    const scroller = root.querySelector("[data-scroller]");
    if (!(scroller instanceof HTMLElement)) return;

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const behavior: ScrollBehavior = reduceMotion ? "auto" : "smooth";

    root.querySelector("[data-prev]")?.addEventListener("click", () => {
      scroller.scrollBy({ left: -cardStep(scroller), behavior });
    });
    root.querySelector("[data-next]")?.addEventListener("click", () => {
      scroller.scrollBy({ left: cardStep(scroller), behavior });
    });

    scroller.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        scroller.scrollBy({ left: -cardStep(scroller), behavior });
      }
      if (event.key === "ArrowRight") {
        event.preventDefault();
        scroller.scrollBy({ left: cardStep(scroller), behavior });
      }
    });
  }

  document.querySelectorAll("[data-carousel]").forEach(setupCarousel);
</script>
