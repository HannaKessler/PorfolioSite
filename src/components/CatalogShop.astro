---
import "../styles/catalog.css";
import CatalogHood from "./CatalogHood.astro";
import CatalogBar from "./CatalogBar.astro";
import CatalogConsent from "./CatalogConsent.astro";
import { initialBrowseHtml, recommendedSlotHtml } from "../scripts/catalog-html";
---

<section class="os" id="open-stock" aria-label="Searchable Shop catalog">
  <CatalogHood />
  <CatalogBar />
  <div id="os-recommended-slot" set:html={recommendedSlotHtml()} />
  <div id="os-stage" set:html={initialBrowseHtml()} />
  <p class="os-note os-credits"><a href="/projects/catalog/credits">Image credits</a></p>
  <CatalogConsent />
</section>

<script>
  import { mountCatalog } from "../scripts/catalog-shop";

  const root = document.getElementById("open-stock");
  if (root) mountCatalog(root);
</script>
