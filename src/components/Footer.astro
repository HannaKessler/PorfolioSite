---
import { site } from "../site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <p>© {year} {site.name}</p>
    <p>Code on GitHub · <a href="/status">Status</a></p>
  </div>
  {Astro.slots.has("default") && (
    <div class="footer-inner footer-credit">
      <slot />
    </div>
  )}
</footer>
