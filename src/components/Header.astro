---
import { getCollection } from "astro:content";
import { site } from "../site";

const demos = (await getCollection("projects"))
  .filter((project) => project.data.listed && project.data.kind === "demo")
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const pathname = Astro.url.pathname;
const isHome = pathname === "/";

function current(href: string) {
  return pathname === href || pathname.startsWith(`${href}/`) ? "page" : undefined;
}

function demoCurrent(id: string) {
  const href = `/projects/${id}`;
  return pathname === href || pathname.startsWith(`${href}/`) ? "page" : undefined;
}
---

{
  !isHome && (
    <header class="site-header">
      <div class="header-inner">
        <a class="logo" href="/">{site.name}</a>
        <nav class="nav" aria-label="Primary">
          <a href="/">Home</a>
          <div class="nav-menu">
            <button
              type="button"
              class="nav-trigger"
              aria-expanded="false"
              aria-haspopup="true"
              aria-controls="demo-menu"
              aria-current={demos.some((demo) => demoCurrent(demo.id)) ? "page" : undefined}
            >
              Demos
            </button>
            <ul class="nav-dropdown" id="demo-menu">
              {demos.map((demo) => (
                <li>
                  <a href={`/projects/${demo.id}`} aria-current={demoCurrent(demo.id)}>
                    {demo.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
          {/* Hidden until the Professional Journey page is filled out.
          <a href="/professional-journey" aria-current={current("/professional-journey")}>
            Professional Journey
          </a> */}
        </nav>
      </div>
    </header>
  )
}

<script>
  document.querySelectorAll(".nav-menu").forEach((menu) => {
    const trigger = menu.querySelector(".nav-trigger");
    if (!(trigger instanceof HTMLButtonElement)) return;

    function setOpen(open: boolean) {
      menu.classList.toggle("is-open", open);
      trigger.setAttribute("aria-expanded", String(open));
    }

    const measure = () => {
      menu.style.setProperty("--tab-w", `${trigger.getBoundingClientRect().width}px`);
    };
    measure();
    document.fonts?.ready.then(measure);
    new ResizeObserver(measure).observe(trigger);

    trigger.addEventListener("click", () => {
      setOpen(!menu.classList.contains("is-open"));
    });

    document.addEventListener("click", (event) => {
      if (event.target instanceof Node && !menu.contains(event.target)) setOpen(false);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });
  });
</script>
