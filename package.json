{
  "name": "portfolio-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "filmgraph:data": "tsx filmgraph/build-seed.ts",
    "filmgraph:codegen": "graphql-codegen --config filmgraph/codegen.ts",
    "filmgraph:typecheck": "tsc -p tsconfig.filmgraph.json",
    "filmgraph:check-seed": "tsx filmgraph/check-seed-size.ts",
    "test": "vitest run",
    "test:unit": "vitest run --exclude tests/film-graph/contract.test.ts",
    "test:contract": "vitest run tests/film-graph/contract.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.1",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@fontsource/faculty-glyphic": "^5.3.0",
    "@graphql-yoga/plugin-persisted-operations": "^3.24.4",
    "@lezer/highlight": "^1.2.5",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "astro": "^7.3.2",
    "cm6-graphql": "^0.2.2",
    "dataloader": "^2.2.3",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.24.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@graphql-codegen/add": "^7.1.1",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-resolvers": "^6.1.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
